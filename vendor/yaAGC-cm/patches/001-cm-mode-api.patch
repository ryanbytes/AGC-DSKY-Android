+/* Select Command Module peripheral behavior before the first CPU operation. */
+static int CpuStarted = 0;
+
+export int
+configure_cm_mode ()
+{
+  if (CpuStarted)
+    return -1;
+  CmOrLm = 1;
+  return CmOrLm;
+}
+
+export int
+get_cm_mode ()
+{
+  return CmOrLm;
+}
+
 /* Resets the CPU. */
 export void
 cpu_reset ()
 {
+  CpuStarted = 1;
   agc_engine_init (&State, NULL, NULL, 0);
 }
 
@@ -105,6 +124,7 @@
 export void
 cpu_step (uint32_t steps)
 {
+  CpuStarted = 1;
   for (uint32_t i = 0; i < steps; i++)
     agc_engine (&State);
 }
