<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/el_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <FrameLayout
        android:id="@+id/el_widget_panel"
        android:layout_width="117.678dp"
        android:layout_height="198.525dp"
        android:layout_gravity="center"
        android:background="#565A56">

        <ImageView
            android:id="@+id/el_widget_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="0dp"
            android:scaleType="fitXY"
            android:contentDescription="Apollo DSKY electroluminescent display" />

        <!-- TextClock is driven by the platform clock inside the launcher process.
             It does not depend on RemoteViews collection adapters, alarms, or
             background execution to advance once per second. -->
        <TextClock
            android:id="@+id/el_hour_clock"
            android:layout_width="106dp"
            android:layout_height="23dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="5.839dp"
            android:layout_marginTop="92.526dp"
            android:format12Hour="'+000'HH"
            android:format24Hour="'+000'HH"
            android:fontFamily="monospace"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:textColor="#6DECB4"
            android:textScaleX="1.62"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/el_minute_clock"
            android:layout_width="106dp"
            android:layout_height="23dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="5.839dp"
            android:layout_marginTop="126.661dp"
            android:format12Hour="'+000'mm"
            android:format24Hour="'+000'mm"
            android:fontFamily="monospace"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:textColor="#6DECB4"
            android:textScaleX="1.62"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/el_seconds_clock"
            android:layout_width="106dp"
            android:layout_height="23dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="5.839dp"
            android:layout_marginTop="160.797dp"
            android:format12Hour="'+000'ss"
            android:format24Hour="'+000'ss"
            android:fontFamily="monospace"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:textColor="#6DECB4"
            android:textScaleX="1.62"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>
</FrameLayout>
